rules_version = '2';

// Portfolio media is public to read; only administrators (UIDs listed in the
// Firestore /admins collection) may upload or delete. Uploads must be images
// or videos within a size limit.
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    match /portfolio/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin()
        && (request.resource.contentType.matches('image/.*') && request.resource.size < 25 * 1024 * 1024
          || request.resource.contentType.matches('video/.*') && request.resource.size < 500 * 1024 * 1024);
      allow delete: if isAdmin();
    }
  }
}
