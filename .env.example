# Copy to .env.local and adjust. All values are optional: without them the app
# uses the production "young24kl" Firebase web config baked into src/firebase.js.
# These are public client identifiers, not secrets. Never put service-account
# keys or other server credentials in VITE_* variables — they ship to browsers.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Local development against the Firebase Emulator Suite (npm run emulators).
# Use with VITE_FIREBASE_PROJECT_ID=demo-young24kl and
# VITE_FIREBASE_STORAGE_BUCKET=demo-young24kl.appspot.com.
VITE_USE_FIREBASE_EMULATORS=false

# Absolute production origin used for Open Graph image URLs, e.g. https://young24kl.com
VITE_SITE_URL=
